# ------------------------------------------------------------
# ECONT
# ------------------------------------------------------------
# Test mode works immediately with Econt's public developer credentials.
ECONT_ENV=test

# Optional in test mode. If blank, the official public demo credentials are used.
ECONT_USERNAME=
ECONT_PASSWORD=

# Test mode defaults to Econt's sample sender data and office 1000.
# Replace these when a real GERPINA e-Econt account is ready.
ECONT_SENDER_NAME=
ECONT_SENDER_PHONE=
ECONT_SENDER_OFFICE_CODE=

# Safety switch. The current checkout integration only calls calculate/validate
# and does NOT create a real waybill even if this is set.
ECONT_CREATE_LABELS=false

# ------------------------------------------------------------
# ORDER EMAIL (for the production phase)
# ------------------------------------------------------------
ORDER_TO_EMAIL=
ORDER_FROM_EMAIL=
EMAIL_PROVIDER_API_KEY=
