# ------------------------------------------------------------
# ECONT
# ------------------------------------------------------------
# Test mode uses Econt's public developer credentials automatically.
# Production mode uses the real e-Econt account credentials stored in Vercel.
ECONT_ENV=test

ECONT_USERNAME=
ECONT_PASSWORD=

# GERPINA agreement for online sales / COD payout.
ECONT_CD_AGREEMENT=CD270387

# Optional. Only add this if Econt confirms the exact SOAP/JSON COD payout template name.
# If left blank, the safe build reads the account's COD payout options through getClientProfiles.
ECONT_CD_PAY_TEMPLATE=

# Optional only if the e-Econt login ever exposes more than one client profile.
# Optional fallback only if the account still cannot be selected automatically via the COD agreement.
ECONT_PROFILE_CLIENT_NUMBER=

# Optional sender-office override. If blank, the first registered sender address from the
# authenticated Econt profile is used for calculate/validate.
ECONT_SENDER_OFFICE_CODE=

# IMPORTANT: this version has no create-label endpoint. It can only calculate and validate.

# ------------------------------------------------------------
# ORDER EMAIL (future live-order phase)
# ------------------------------------------------------------
ORDER_TO_EMAIL=
ORDER_FROM_EMAIL=
EMAIL_PROVIDER_API_KEY=
